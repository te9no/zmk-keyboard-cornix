#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

// quick tapping for shift

#define BASE 0
#define FUNC 1
#define NUM 2
#define ADJUST 3
#define NAVI 4
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&tog_ls { layout-maps = <&layout_shift_map_us_to_jis>; };

/* Keep Layout Shift after Keymap Editor reorders standard includes. */
&kp { compatible = "zmk,behavior-layout-shift-key-press"; };
/* The driver implements one instance; route the optional mod-tap through it. */
&kpls { status = "disabled"; };
&mtls { bindings = <&kp>, <&kp>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        rsr_left: rsr_left {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        rsr_right: rsr_right {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp PG_UP>;
            ccw-binding = <&kp PG_DN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB                  &kp Q         &kp W         &kp E        &kp R        &kp T                        &kp Y      &kp U      &kp I      &kp O       &kp P          &kp BACKSPACE
&lt 3 ESCAPE             &kp A         &kp S         &kp D        &kp F        &kp G                        &kp H      &kp J      &kp K      &kp L       &kp BACKSLASH  &kp RETURN
&kp LEFT_SHIFT           &kp Z         &kp X         &kp C        &kp V        &kp B          &none  &none  &kp N      &kp M      &kp COMMA  &kp PERIOD  &kp UP         &kp SLASH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT  &lt 1 SPACE  &lt 2 SPACE  &kp BACKSPACE                &kp LANG1  &kp LANG2  &none      &kp LEFT    &kp DOWN       &kp RIGHT
            >;

            sensor-bindings = <&rsr_left>, <&rsr_right>;
        };

        func {
            bindings = <
&trans  &kp PAGE_UP    &kp UP      &kp PAGE_DOWN  &trans   &trans                         &kp F1   &kp F2   &kp F3         &kp F4   &kp F5   &trans
&trans  &kp LEFT       &kp DOWN    &kp RIGHT      &trans   &trans                         &kp F6   &kp F7   &kp F8         &kp F9   &kp F10  &trans
&trans  &kp BACKSPACE  &kp DELETE  &kp HOME       &kp END  &trans         &trans  &trans  &kp F11  &kp F12  &kp SEMICOLON  &kp SQT  &trans   &trans
&none   &none          &none       &trans         &trans   &kp BACKSPACE                  &trans   &trans   &trans         &none    &none    &none
            >;

            sensor-bindings = <&rsr_left>, <&rsr_right>;
        };

        num {
            bindings = <
&bt BT_CLR  &kp N1         &kp N2      &kp N3      &kp N4  &kp N5                  &kp N6     &kp N7     &kp N8            &kp N9             &kp N0         &trans
&tog_ls     &trans         &trans      &trans      &trans  &trans                  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans      &kp BACKSPACE  &kp DELETE  &trans      &trans  &trans  &trans  &trans  &trans     &kp SLASH  &kp SEMICOLON     &kp SQT            &trans         &trans
&none       &none          &none       &kp RETURN  &none   &none                   &none      &none      &trans            &none              &none          &none
            >;

            sensor-bindings = <&rsr_left>, <&rsr_right>;
        };

        bt {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&none  &trans        &trans        &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&none  &none         &none         &none         &none   &trans  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &none         &none         &trans        &trans  &trans                          &none   &none   &trans  &none   &none   &none
            >;

            sensor-bindings = <&rsr_left>, <&rsr_right>;
        };

        navi {
            bindings = <
&none  &none  &none            &mmv 64936  &kp PAGE_UP    &kp PAGE_DOWN                  &mkp MB1  &mkp MB3  &mkp MB2  &msc 15    &msc 65521  &none
&none  &none  &mmv 4255645696  &mmv 600    &mmv 39321600  &msc 15                        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none       &none
&none  &none  &none            &none       &none          &msc 65521     &trans  &trans  &trans    &trans    &none     &none      &none       &none
&none  &none  &none            &mo 7       &trans         &trans                         &none     &none     &kp N5    &none      &none       &none
            >;

            sensor-bindings = <&rsr_left>, <&rsr_right>;
        };
    };
};
