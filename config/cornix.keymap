#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define FUNC 1
#define NUM 2
#define ADJUST 3
#define NAVI 4

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <layout_shift_kp_override.dtsi>

&tog_ls {
    layout-maps = <&layout_shift_map_us_to_jis>;
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        rsr_left: rsr_left {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_right: rsr_right {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp PG_UP>;
            ccw-binding = <&kp PG_DN>;
        };

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //flavor = "balanced";

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_ltm {
            bindings = <&kp ESC>;
            key-positions = <2 4>;
            layers = <0 1>;
        };

        cb_lm {
            bindings = <&kp TAB>;
            key-positions = <14 16>;
            layers = <0 1>;
        };

        cb_enter {
            bindings = <&kp RET>;
            key-positions = <21 19>;
            layers = <0 1>;
        };

        layer3 {
            bindings = <&kp N3>;
            key-positions = <5 6>;
        };

        layer4 {
            bindings = <&kp N4>;
            key-positions = <5 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BACKSPACE
                &lt 4 ESCAPE    &kp A    &kp S    &kp D    &kp F    &kp G
                &kp H    &kp J    &kp K    &kp L    &kp NON_US_BACKSLASH    &kp RETURN
                &kp LEFT_SHIFT    &kp Z    &kp X    &kp C    &kp V    &kp B
                &none    &none    &kp N    &kp M    &kp COMMA    &kp PERIOD
                &kp UP    &kp SLASH    &mt LEFT_CONTROL ESCAPE    &kp LEFT_GUI    &kp LEFT_ALT    &lt 2 SPACE
                &lt 3 SPACE    &lt 5 SPACE    &kp LANG1    &kp LANG2    &none    &kp LEFT
                &kp DOWN    &kp RIGHT
            >;
            sensor-bindings = <&rsr_left &rsr_right>;
        };

        func {
            display-name = "Function";
            bindings = <
                &none    &kp PAGE_UP    &kp UP    &kp PAGE_DOWN    &trans    &trans
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &trans
                &none    &kp LEFT    &kp DOWN    &kp RIGHT    &trans    &trans
                &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &trans
                &none    &kp BACKSPACE    &kp DELETE    &kp 34013258    &kp END    &trans
                &trans    &trans    &kp F11    &kp 34013253    &kp GRAVE    &kp 34013237
                &kp SQT    &none    &none    &none    &none    &trans
                &trans    &trans    &kp 34013237    &trans    &kp GRAVE    &none
                &none    &none
            >;
            sensor-bindings = <&rsr_left &rsr_right>;
        };

        num {
            display-name = "Number";
            bindings = <
                &trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &kp MINUS    &kp EQUAL    &kp LEFT_BRACKET    &kp RIGHT_BRACKET    &kp 34013233    &trans
                &trans    &kp BACKSPACE    &kp DELETE    &trans    &trans    &trans
                &trans    &trans    &trans    &kp SLASH    &kp SEMICOLON    &kp SQT
                &trans    &trans    &none    &none    &none    &kp RETURN
                &trans    &kp BACKSPACE    &trans    &trans    &trans    &none
                &none    &none
            >;
            sensor-bindings = <&rsr_left &rsr_right>;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
                &bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &none    &none    &none    &none    &none    &none
                &tog_ls    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &none    &none    &none    &tog 1
                &bt BT_CLR_ALL    &none    &none    &none    &none    &none
                &trans    &trans    &none    &none    &none    &none
                &ext_power 1    &trans    &none    &none    &none    &none
                &none    &none    &none    &none    &trans    &none
                &none    &none
            >;
            sensor-bindings = <&rsr_left &rsr_right>;
        };

        navi {
            display-name = "Navigation";
            bindings = <
                &none    &none    &none    &mmv 64936    &kp PAGE_UP    &kp PAGE_DOWN
                &mkp MB1    &mkp MB3    &mkp MB2    &msc 15    &msc 65521    &none
                &none    &none    &mmv 4255645696    &mmv 600    &mmv 39321600    &msc 15
                &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &none    &none
                &none    &none    &none    &none    &none    &msc 65521
                &trans    &trans    &trans    &trans    &none    &none
                &none    &none    &none    &none    &none    &mo 7
                &trans    &trans    &none    &none    &kp N5    &none
                &none    &none
            >;
            sensor-bindings = <&rsr_left &rsr_right>;
        };
    };
};
