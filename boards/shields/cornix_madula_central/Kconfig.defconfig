if SHIELD_CORNIX_MADULA_CENTRAL

config ZMK_KEYBOARD_NAME
    default "Cornix Madula"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

if ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif

config ZMK_BLE
    default y

config ZMK_USB
    default y

config INPUT
    default y

config ZMK_POINTING
    default y

config ADC
    default y

config ADC_NRFX_SAADC
    default y

config GPIO
    default y

endif # SHIELD_CORNIX_MADULA_CENTRAL
