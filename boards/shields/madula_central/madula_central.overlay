#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "../../jzf/cornix/cornix_dongle_common.dtsi"

/ {
    chosen {
        zmk,battery = &vbatt;
        zmk,physical-layout = &layout_50;
        zmk,kscan = &madula_kscan;
    };

    aliases {
        status-ws2812 = &madula_led_strip;
    };

    /*
     * SW3/SW4/SW5 are wired independently to S1/S2/S3. The composite row
     * offset places them after the 50 Cornix positions (50, 51, 52).
     */
    madula_kscan: madula_kscan {
        compatible = "zmk,kscan-composite";

        direct {
            row-offset = <4>;
            kscan = <&madula_direct>;
        };
    };

    madula_direct: madula_direct {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios =
            <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* Madula QL5 is a high-side P-MOSFET, so LED_EN_L is active low. */
    madula_led_power: EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
        init-delay-ms = <10>;
    };
};

/* Keep peripheral positions 0-49 and append the three central direct keys. */
&default_transform {
    rows = <5>;
    map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,12) RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(1,13) RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                   RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7)
        RC(4,0) RC(4,1) RC(4,2)
    >;
};

&pinctrl {
    madula_led_spi_default: madula_led_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 28)>;
        };
    };

    madula_led_spi_sleep: madula_led_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 28)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&madula_led_spi_default>;
    pinctrl-1 = <&madula_led_spi_sleep>;
    pinctrl-names = "default", "sleep";

    madula_led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        reset-delay = <280>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&adc {
    status = "okay";
};

/*
 * The ZMK XIAO BLE board variant defines vbatt for the carrier board's
 * divider. Madula has its own divider on A0, so retain Madula's electrical
 * values while reusing the board-provided node label.
 */
&vbatt {
    io-channels = <&adc 0>;
    /delete-property/ power-gpios;
    output-ohms = <1000000>;
    full-ohms = <1000000>;
};

/*
 * XIAO connector defaults occupy every Madula J4 signal: UART TX uses P1.12,
 * while SPI2 uses P1.13/P1.14/P1.15. I2C1 also claims connector pins used by
 * Madula's direct keys. Module snippets enable only their dedicated spi0 or
 * i2c0 controller when required.
 */
&xiao_serial {
    status = "disabled";
};

&xiao_spi {
    status = "disabled";
};

&xiao_i2c {
    status = "disabled";
};
